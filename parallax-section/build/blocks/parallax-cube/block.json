{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "psb/parallax-cube",
  "title": "Parallax Cube (Pro)",
  "description": "A real 3D cube whose faces quarter-turn to swap content panels, lit as it spins, in four styles.",
  "category": "parallax-sections",
  "version": "2.1.0",
  "keywords": [
    "cube",
    "3d",
    "prism",
    "rotator",
    "tabs",
    "showcase",
    "carousel",
    "parallax"
  ],
  "textdomain": "parallax-section",
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    },
    "styleSl": {
      "type": "string",
      "default": "styleDefault",
      "enum": [
        "styleDefault",
        "styleOne",
        "styleTwo",
        "styleThree"
      ]
    },
    "showHeader": {
      "type": "boolean",
      "default": true
    },
    "badge": {
      "type": "string",
      "default": "3D Showcase"
    },
    "heading": {
      "type": "string",
      "default": "Every angle of the platform"
    },
    "subheading": {
      "type": "string",
      "default": "Pick a side — the cube makes a quarter-turn to bring it to the front, catching the light as it goes."
    },
    "headingTag": {
      "type": "string",
      "default": "h2"
    },
    "faceTitleTag": {
      "type": "string",
      "default": "h3"
    },
    "faces": {
      "type": "array",
      "default": [
        {
          "image": "",
          "imageAlt": "",
          "eyebrow": "Performance",
          "title": "Built for speed",
          "text": "Sub-second loads on every page, on every device, everywhere in the world.",
          "btnText": "Learn more",
          "btnUrl": "#",
          "newTab": false
        },
        {
          "image": "",
          "imageAlt": "",
          "eyebrow": "Security",
          "title": "Secure by default",
          "text": "SSO, audit logs and granular permissions are switched on from day one.",
          "btnText": "Learn more",
          "btnUrl": "#",
          "newTab": false
        },
        {
          "image": "",
          "imageAlt": "",
          "eyebrow": "Scale",
          "title": "Grows with you",
          "text": "From your first user to your millionth, without a single rewrite.",
          "btnText": "Learn more",
          "btnUrl": "#",
          "newTab": false
        },
        {
          "image": "",
          "imageAlt": "",
          "eyebrow": "Teams",
          "title": "Loved by teams",
          "text": "Thoughtful workflows your whole team will actually enjoy using.",
          "btnText": "Learn more",
          "btnUrl": "#",
          "newTab": false
        }
      ]
    },
    "showButtons": {
      "type": "boolean",
      "default": true
    },
    "showIndex": {
      "type": "boolean",
      "default": true
    },
    "maxWidth": {
      "type": "object",
      "default": {
        "desktop": "1200px",
        "tablet": "100%",
        "mobile": "100%"
      }
    },
    "columnGap": {
      "type": "object",
      "default": {
        "desktop": "72px",
        "tablet": "48px",
        "mobile": "32px"
      }
    },
    "cubeWidth": {
      "type": "object",
      "default": {
        "desktop": "400px",
        "tablet": "360px",
        "mobile": "300px"
      }
    },
    "cubeHeight": {
      "type": "object",
      "default": {
        "desktop": "400px",
        "tablet": "360px",
        "mobile": "300px"
      }
    },
    "mediaHeight": {
      "type": "object",
      "default": {
        "desktop": "140px",
        "tablet": "120px",
        "mobile": "100px"
      }
    },
    "contentAlign": {
      "type": "string",
      "default": "left"
