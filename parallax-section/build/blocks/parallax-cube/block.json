    "verticalAlign": {
      "type": "string",
      "default": "center"
    },
    "showNav": {
      "type": "boolean",
      "default": true
    },
    "showArrows": {
      "type": "boolean",
      "default": true
    },
    "axis": {
      "type": "string",
      "default": "y"
    },
    "scrollMode": {
      "type": "string",
      "default": "pin",
      "enum": [
        "none",
        "pin"
      ]
    },
    "pinLength": {
      "type": "number",
      "default": 80
    },
    "pinMobile": {
      "type": "boolean",
      "default": true
    },
    "pinProgress": {
      "type": "boolean",
      "default": true
    },
    "autoplay": {
      "type": "boolean",
      "default": false
    },
    "autoplayInterval": {
      "type": "number",
      "default": 5
    },
    "pauseOnHover": {
      "type": "boolean",
      "default": true
