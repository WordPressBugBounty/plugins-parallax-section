    "perspective": {
      "type": "number",
      "default": 1400
    },
    "lighting": {
      "type": "boolean",
      "default": true
    },
    "lightIntensity": {
      "type": "number",
      "default": 0.55
    },
    "tiltMax": {
      "type": "number",
      "default": 8
    },
    "scrollParallax": {
      "type": "boolean",
      "default": true
    },
    "parallaxIntensity": {
      "type": "number",
      "default": 60
    },
    "floatEffect": {
      "type": "boolean",
      "default": true
    },
    "floatDistance": {
      "type": "number",
      "default": 14
    },
    "floatSpeed": {
      "type": "number",
      "default": 6
