{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "psb/parallax-testimonials",
  "title": "Parallax Testimonials (Pro)",
  "description": "Testimonial cards in a 3D coverflow carousel with autoplay, pointer tilt and four styles.",
  "category": "parallax-sections",
  "version": "2.1.1",
  "keywords": [
    "testimonials",
    "reviews",
    "quotes",
    "carousel",
    "coverflow",
    "slider",
    "rating",
    "social proof"
  ],
  "textdomain": "parallax-section",
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    },
    "styleSl": {
      "type": "string",
      "default": "styleDefault",
      "enum": [
        "styleDefault",
        "styleOne",
        "styleTwo",
        "styleThree"
      ]
    },
    "showHeader": {
      "type": "boolean",
      "default": true
    },
    "badge": {
      "type": "string",
      "default": "Wall of love"
    },
    "heading": {
      "type": "string",
      "default": "Loved by teams everywhere"
    },
    "subheading": {
      "type": "string",
      "default": "Real words from the people who build with us every day."
    },
    "headingTag": {
      "type": "string",
      "default": "h2"
    },
    "testimonials": {
      "type": "array",
      "default": [
        {
          "quote": "The most polished tool we have adopted in years. Onboarding took an afternoon and the whole team was productive by lunch.",
          "name": "Jane Cooper",
          "role": "Head of Design",
          "company": "Acme",
          "avatar": "",
          "avatarAlt": "",
          "logo": "",
          "logoAlt": "",
          "rating": 5,
          "url": "",
          "newTab": false
        },
        {
          "quote": "We cut our build time in half and shipped two features we had been putting off for months. Support is genuinely exceptional.",
          "name": "Marcus Lee",
          "role": "CTO",
          "company": "Northwind",
          "avatar": "",
          "avatarAlt": "",
          "logo": "",
          "logoAlt": "",
          "rating": 5,
          "url": "",
          "newTab": false
        },
        {
          "quote": "It just works. The defaults are smart, the docs are clear and it scales without drama as our traffic grows.",
          "name": "Priya Sharma",
          "role": "Founder",
          "company": "Lumen",
          "avatar": "",
          "avatarAlt": "",
          "logo": "",
          "logoAlt": "",
          "rating": 4,
          "url": "",
          "newTab": false
        },
        {
          "quote": "Our conversion rate jumped the week we launched. Customers keep telling us the site finally feels premium.",
          "name": "Diego Alvarez",
          "role": "Growth Lead",
          "company": "Brightline",
          "avatar": "",
          "avatarAlt": "",
          "logo": "",
          "logoAlt": "",
          "rating": 5,
          "url": "",
          "newTab": false
        },
        {
          "quote": "Clear pricing, zero surprises and a team that answers in minutes. Exactly what a small studio like ours needs.",
          "name": "Hannah Kim",
          "role": "Creative Director",
          "company": "Studio North",
          "avatar": "",
          "avatarAlt": "",
          "logo": "",
          "logoAlt": "",
          "rating": 5,
          "url": "",
          "newTab": false
        }
      ]
    },
    "showRating": {
      "type": "boolean",
      "default": true
    },
    "showQuoteMark": {
      "type": "boolean",
      "default": true
    },
    "showAvatar": {
      "type": "boolean",
      "default": true
    },
    "showLogo": {
      "type": "boolean",
      "default": true
    },
    "avatarShape": {
      "type": "string",
      "default": "round"
    },
    "maxWidth": {
      "type": "object",
      "default": {
        "desktop": "1200px",
        "tablet": "100%",
        "mobile": "100%"
      }
    },
    "cardWidth": {
      "type": "object",
      "default": {
        "desktop": "440px",
        "tablet": "400px",
        "mobile": "86%"
      }
    },
    "cardMinHeight": {
      "type": "object",
      "default": {
        "desktop": "320px",
        "tablet": "300px",
        "mobile": "0px"
      }
    },
    "avatarSize": {
      "type": "object",
      "default": {
        "desktop": "52px",
        "tablet": "48px",
        "mobile": "44px"
      }
    },
    "contentAlign": {
      "type": "string",
      "default": "left"
    },
    "visibleSides": {
      "type": "number",
      "default": 2
    },
    "startIndex": {
      "type": "number",
      "default": 0
    },
    "loop": {
      "type": "boolean",
      "default": true
    },
    "showArrows": {
      "type": "boolean",
      "default": true
    },
    "showDots": {
      "type": "boolean",
      "default": true
    },
    "swipe": {
      "type": "boolean",
      "default": true
    },
    "autoplay": {
      "type": "boolean",
      "default": true
    },
    "autoplayDelay": {
      "type": "number",
      "default": 5
    },
    "pauseOnHover": {
      "type": "boolean",
      "default": true
    },
    "transitionSpeed": {
      "type": "number",
      "default": 0.7
    },
    "transitionEase": {
      "type": "string",
      "default": "cubic-bezier(0.22,1,0.36,1)"
    },
    "scrollMode": {
      "type": "string",
      "default": "pin",
      "enum": [
        "none",
        "pin"
      ]
    },
    "pinLength": {
      "type": "number",
      "default": 70
    },
    "pinMobile": {
      "type": "boolean",
      "default": true
    },
    "pinProgress": {
      "type": "boolean",
      "default": true
    },
    "cfRotate": {
      "type": "number",
      "default": 38
    },
    "cfScale": {
      "type": "number",
      "default": 0.82
    },
    "cfOpacity": {
      "type": "number",
      "default": 0.55
    },
    "cfSpread": {
      "type": "number",
      "default": 62
    },
    "perspective": {
      "type": "number",
      "default": 1400
    },
    "tiltMax": {
      "type": "number",
      "default": 8
    },
    "glare": {
      "type": "boolean",
      "default": true
    },
    "glareIntensity": {
      "type": "number",
      "default": 0.3
    },
    "entrance": {
      "type": "boolean",
      "default": true
    },
    "entranceStagger": {
      "type": "number",
      "default": 0.12
    },
    "sectionPadding": {
      "type": "object",
      "default": {
        "desktop": {
          "top": "96px",
          "right": "24px",
          "bottom": "96px",
          "left": "24px"
        },
        "tablet": {
          "top": "72px",
          "right": "20px",
          "bottom": "72px",
          "left": "20px"
        },
        "mobile": {
          "top": "56px",
          "right": "16px",
          "bottom": "56px",
          "left": "16px"
        }
      }
    },
    "sectionMargin": {
      "type": "object",
      "default": {
        "desktop": {
          "top": "0px",
          "right": "0px",
          "bottom": "0px",
          "left": "0px"
        },
        "tablet": {
          "top": "0px",
          "right": "0px",
          "bottom": "0px",
          "left": "0px"
        },
        "mobile": {
          "top": "0px",
          "right": "0px",
          "bottom": "0px",
          "left": "0px"
        }
      }
    },
    "background": {
      "type": "object",
      "default": {
        "type": "gradient",
        "gradient": "radial-gradient(ellipse at 50% 0%,#1e1b4b 0%,#0b1020 60%)"
      }
    },
    "accentColor": {
      "type": "string",
      "default": "#a78bfa"
    },
    "headingTypography": {
      "type": "object",
      "default": {
        "fontSize": {
          "desktop": 44,
          "tablet": 36,
          "mobile": 30
        },
        "fontWeight": 800,
        "lineHeight": "1.15"
      }
    },
    "headingColor": {
      "type": "string",
      "default": "#f8fafc"
    },
    "subheadingTypography": {
      "type": "object",
      "default": {
        "fontSize": {
          "desktop": 18,
          "tablet": 17,
          "mobile": 16
        },
        "lineHeight": "1.6"
      }
    },
    "subheadingColor": {
      "type": "string",
      "default": "rgba(226,232,240,0.7)"
    },
    "badgeColors": {
      "type": "object",
      "default": {
        "color": "#c4b5fd",
        "bg": "rgba(167,139,250,0.16)"
      }
    },
    "cardBackground": {
      "type": "object",
      "default": {
        "type": "solid",
        "color": "rgba(255,255,255,0.06)"
      }
    },
    "cardRadius": {
      "type": "object",
      "default": {
        "desktop": {
          "top": "20px",
          "right": "20px",
          "bottom": "20px",
          "left": "20px"
        },
        "tablet": {
          "top": "20px",
          "right": "20px",
          "bottom": "20px",
          "left": "20px"
        },
        "mobile": {
          "top": "20px",
          "right": "20px",
          "bottom": "20px",
          "left": "20px"
        }
      }
    },
    "cardPadding": {
      "type": "object",
      "default": {
        "desktop": {
          "top": "32px",
          "right": "32px",
          "bottom": "32px",
          "left": "32px"
        },
        "tablet": {
          "top": "28px",
          "right": "28px",
          "bottom": "28px",
          "left": "28px"
        },
        "mobile": {
          "top": "24px",
          "right": "24px",
          "bottom": "24px",
          "left": "24px"
        }
      }
    },
    "cardShadow": {
      "type": "array",
      "default": [
        {
          "hOffset": "0px",
          "vOffset": "30px",
          "blur": "60px",
          "spreed": "-20px",
          "color": "rgba(0,0,0,0.55)",
          "isInset": false
        }
      ]
    },
    "cardBorderWidth": {
      "type": "string",
      "default": "1px"
    },
    "cardBorderColor": {
      "type": "string",
      "default": "rgba(255,255,255,0.12)"
    },
    "quoteTypography": {
      "type": "object",
      "default": {
        "fontSize": {
          "desktop": 19,
          "tablet": 18,
          "mobile": 17
        },
        "fontWeight": 500,
        "lineHeight": "1.6"
      }
    },
    "quoteColor": {
      "type": "string",
      "default": "#e2e8f0"
    },
    "quoteMarkColor": {
      "type": "string",
      "default": "#a78bfa"
    },
    "starColor": {
      "type": "string",
      "default": "#fbbf24"
    },
    "nameTypography": {
      "type": "object",
      "default": {
        "fontSize": {
          "desktop": 16,
          "tablet": 16,
          "mobile": 15
        },
        "fontWeight": 700,
        "lineHeight": "1.25"
      }
    },
    "nameColor": {
      "type": "string",
      "default": "#f8fafc"
    },
    "roleTypography": {
      "type": "object",
      "default": {
        "fontSize": {
          "desktop": 14,
          "tablet": 14,
          "mobile": 13
        },
        "lineHeight": "1.35"
      }
    },
    "roleColor": {
      "type": "string",
      "default": "rgba(226,232,240,0.6)"
    },
    "navColors": {
      "type": "object",
      "default": {
        "color": "#f8fafc",
        "bg": "rgba(167,139,250,0.16)"
      }
    },
    "navHoverColors": {
      "type": "object",
      "default": {
        "color": "#0b1020",
        "bg": "#a78bfa"
      }
    },
    "dotColor": {
      "type": "string",
      "default": "rgba(226,232,240,0.3)"
    },
    "dotActiveColor": {
      "type": "string",
      "default": "#a78bfa"
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false
  },
  "example": {
    "attributes": {
      "heading": "Loved by teams everywhere",
      "autoplay": false,
      "entrance": false
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./view.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}